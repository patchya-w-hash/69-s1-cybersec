# Database configuration
DB_NAME=strapi
DB_USER=strapi
DB_PASS=replace_with_strong_password

# pgAdmin configuration
PG_EMAIL=admin@example.com
PG_PASS=replace_with_strong_admin_pass

# Strapi Application Keys and Salts (Generate using: openssl rand -base64 32)
APP_KEYS=replace_with_comma_separated_keys
APP_API_TOKEN_SALT=replace_with_random_salt
APP_ADMIN_JWT_SECRET=replace_with_random_jwt_secret
APP_TRANSFER_TOKEN_SALT=replace_with_random_transfer_salt
APP_JWT_SECRET=replace_with_random_jwt_secret

# Email / SMTP Configuration
EMAIL_SMTP_PASS=replace_with_smtp_password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
EMAIL_DEFAULT_FROM=noreply@example.com
EMAIL_DEFAULT_REPLY_TO=noreply@example.com

# REST Client / API Test Environment Variables
BASE_URL=http://localhost:9092
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_admin_password
USER_EMAIL=user@example.com
USER_USERNAME=test_user
USER_PASSWORD=replace_with_user_password
