# Database configuration
DB_NAME=strapi
DB_USER=strapi
DB_PASS=replace_with_strong_password

# pgAdmin configuration
PG_EMAIL=admin@example.com
PG_PASS=replace_with_strong_admin_pass

# Strapi Application Keys and Salts (Generate using: openssl rand -base64 32)
APP_KEYS=replace_with_comma_separated_keys
APP_API_TOKEN_SALT=replace_with_random_salt
APP_ADMIN_JWT_SECRET=replace_with_random_jwt_secret
APP_TRANSFER_TOKEN_SALT=replace_with_random_transfer_salt
APP_JWT_SECRET=replace_with_random_jwt_secret
